---
import type { Lang } from '../lib/site';
import { words } from '../lib/site';

const { stack, lang, heading, note, variant = 'default' } = Astro.props as {
  stack: string[];
  lang: Lang;
  heading?: { en: string; vi: string };
  note?: { en: string; vi: string };
  variant?: 'default' | 'hmer';
};

type TechMark = { mark: string; color: string; ink: string; icon?: string };

const marks: Record<string, TechMark> = {
  'Next.js 14.1': { mark: 'N', color: '#111827', ink: '#fff', icon: 'nextdotjs' },
  'React 18': { mark: '⚛', color: '#61dafb', ink: '#087ea4', icon: 'react' },
  'React 19': { mark: '⚛', color: '#61dafb', ink: '#087ea4', icon: 'react' },
  React: { mark: '⚛', color: '#61dafb', ink: '#087ea4', icon: 'react' },
  TypeScript: { mark: 'TS', color: '#3178c6', ink: '#fff', icon: 'typescript' },
  'Vite 8': { mark: 'V', color: '#9135ff', ink: '#fff', icon: 'vite' },
  Vite: { mark: 'V', color: '#9135ff', ink: '#fff', icon: 'vite' },
  'Ant Design 6': { mark: 'A', color: '#1677ff', ink: '#fff', icon: 'antdesign' },
  'Ant Design': { mark: 'A', color: '#1677ff', ink: '#fff', icon: 'antdesign' },
  'Apache ECharts 6': { mark: 'EC', color: '#aa344d', ink: '#fff', icon: 'apacheecharts' },
  'Apache ECharts': { mark: 'EC', color: '#aa344d', ink: '#fff', icon: 'apacheecharts' },
  'Zustand 5': { mark: 'Z', color: '#443e38', ink: '#fff' },
  Zustand: { mark: 'Z', color: '#443e38', ink: '#fff' },
  'React Router 7': { mark: 'RR', color: '#ca4245', ink: '#fff', icon: 'reactrouter' },
  'React Router': { mark: 'RR', color: '#ca4245', ink: '#fff', icon: 'reactrouter' },
  PixiJS: { mark: 'Px', color: '#e72264', ink: '#fff' },
  'Tailwind CSS': { mark: 'TW', color: '#06b6d4', ink: '#fff', icon: 'tailwindcss' },
  'Radix UI': { mark: 'R', color: '#111827', ink: '#fff', icon: 'radixui' },
  'shadcn/ui': { mark: 'ui', color: '#111827', ink: '#fff', icon: 'shadcnui' },
  SWR: { mark: 'S', color: '#111827', ink: '#fff', icon: 'swr' },
  Axios: { mark: 'A', color: '#5a29e4', ink: '#fff', icon: 'axios' },
  FastAPI: { mark: 'API', color: '#009688', ink: '#fff', icon: 'fastapi' },
  Python: { mark: 'Py', color: '#3776ab', ink: '#fff', icon: 'python' },
  'Python 3.11': { mark: 'Py', color: '#3776ab', ink: '#fff', icon: 'python' },
  'Python 3.7': { mark: 'Py', color: '#3776ab', ink: '#fff', icon: 'python' },
  'SQLAlchemy 2': { mark: 'SA', color: '#d71f00', ink: '#fff', icon: 'sqlalchemy' },
  SQLAlchemy: { mark: 'SA', color: '#d71f00', ink: '#fff', icon: 'sqlalchemy' },
  Alembic: { mark: 'Al', color: '#6b7280', ink: '#fff' },
  Pydantic: { mark: 'Pd', color: '#e92063', ink: '#fff', icon: 'pydantic' },
  JWT: { mark: 'JWT', color: '#111827', ink: '#fff' },
  'HTTP/REST': { mark: '↔', color: '#64748b', ink: '#fff', icon: 'api' },
  SSE: { mark: 'SSE', color: '#2563eb', ink: '#fff' },
  gRPC: { mark: 'RPC', color: '#244c5a', ink: '#fff', icon: 'grpc' },
  'NVIDIA Triton Inference Server': { mark: 'T', color: '#76b900', ink: '#102000', icon: 'nvidia' },
  'Hugging Face Transformers': { mark: 'HF', color: '#fbbf24', ink: '#3f2a00', icon: 'huggingface' },
  PyTorch: { mark: 'PT', color: '#ee4c2c', ink: '#fff', icon: 'pytorch' },
  'PyTorch 1.8.1': { mark: 'PT', color: '#ee4c2c', ink: '#fff', icon: 'pytorch' },
  'PyTorch Lightning': { mark: 'PL', color: '#792ee5', ink: '#fff', icon: 'pytorch-lightning' },
  'PyTorch Lightning 1.4.9': { mark: 'PL', color: '#792ee5', ink: '#fff', icon: 'pytorch-lightning' },
  CUDA: { mark: 'CUDA', color: '#76b900', ink: '#102000', icon: 'nvidia' },
  'CUDA 11.1': { mark: 'CUDA', color: '#76b900', ink: '#102000', icon: 'nvidia' },
  'Weights & Biases': { mark: 'W&B', color: '#ffbe00', ink: '#271f00', icon: 'wandb' },
  CROHME: { mark: '∑', color: '#315c9c', ink: '#fff', icon: 'crohme' },
  'CROHME 2014 / 2016 / 2019': { mark: '∑', color: '#315c9c', ink: '#fff', icon: 'crohme' },
  'Torchvision + OpenCV': { mark: 'CV', color: '#0f766e', ink: '#fff', icon: 'torchvision-opencv' },
  Pillow: { mark: 'PIL', color: '#4f46e5', ink: '#fff', icon: 'pillow' },
  Einops: { mark: 'E', color: '#7654c8', ink: '#fff', icon: 'einops' },
  TorchMetrics: { mark: 'TM', color: '#be123c', ink: '#fff', icon: 'torchmetrics' },
  MongoDB: { mark: 'M', color: '#47a248', ink: '#fff', icon: 'mongodb' },
  'TimescaleDB / PostgreSQL 16': { mark: 'PG', color: '#4169e1', ink: '#fff', icon: 'postgresql' },
  'TimescaleDB / PostgreSQL': { mark: 'PG', color: '#4169e1', ink: '#fff', icon: 'postgresql' },
  'Redis 7': { mark: 'R', color: '#ff4438', ink: '#fff', icon: 'redis' },
  Redis: { mark: 'R', color: '#ff4438', ink: '#fff', icon: 'redis' },
  'EMQX 5': { mark: 'E', color: '#5f2eea', ink: '#fff' },
  EMQX: { mark: 'E', color: '#5f2eea', ink: '#fff' },
  'MQTT 5': { mark: 'MQ', color: '#660066', ink: '#fff', icon: 'mqtt' },
  MQTT: { mark: 'MQ', color: '#660066', ink: '#fff', icon: 'mqtt' },
  'MQTT.js': { mark: 'MQ', color: '#660066', ink: '#fff', icon: 'mqtt' },
  'Celery 5': { mark: 'C', color: '#37814a', ink: '#fff', icon: 'celery' },
  Celery: { mark: 'C', color: '#37814a', ink: '#fff', icon: 'celery' },
  Motor: { mark: 'Mo', color: '#47a248', ink: '#fff', icon: 'mongodb' },
  RDKit: { mark: 'RD', color: '#6d5aa4', ink: '#fff', icon: 'molecule' },
  OpenBabel: { mark: 'OB', color: '#0f766e', ink: '#fff', icon: 'molecule' },
  'AutoDock Vina': { mark: 'V', color: '#be123c', ink: '#fff', icon: 'molecule3d' },
  PLIP: { mark: 'PL', color: '#7c3aed', ink: '#fff', icon: 'protein' },
