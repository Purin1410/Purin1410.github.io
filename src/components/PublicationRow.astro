---
import type { CollectionEntry } from 'astro:content';
import { type Lang, t, words, workPath } from '../lib/site';
import Icon from './Icon.astro';
import Media from './Media.astro';
const { paper, lang } = Astro.props as { paper: CollectionEntry<'publications'>; lang: Lang };
const p = paper.data;
const paperHref = p.links.doi || p.links.pdf || p.links.arxiv;
const statusLabels = {published:words(lang,'Published','Đã xuất bản'),accepted:words(lang,'Accepted','Đã được nhận'),submitted:words(lang,'Submitted','Đã gửi'), 'under-review':words(lang,'Under review','Đang phản biện')};
---
<article class:list={['publication-row',p.kind]} id={`paper-${p.slug}`} data-paper={p.slug}>
  <div class="publication-mark"><Icon name="paper" size={25} /></div>
  <div class="publication-content">
    {p.thumbnail && <div class="publication-thumbnail"><Media media={p.thumbnail} lang={lang} /></div>}
    <div class="publication-meta"><span class:list={['venue-type',p.kind]}>{p.kind==='conference' ? words(lang,'Conference','Hội nghị') : words(lang,'Journal','Tạp chí')}</span><span class="venue-short">{p.venueShort} · {p.year}</span><span class="publication-status">{statusLabels[p.status]}</span></div>
    <h3>{paperHref ? <a href={paperHref} target="_blank" rel="noopener noreferrer">{p.title}</a> : p.title}</h3>
    <p class="authors">{p.authors.map((author,index) => <>{index>0 && ', '}{author.self ? <strong>{author.name}</strong> : <span>{author.name}</span>}</>)}</p>
    <p class="publication-venue">{p.venue}</p>
    <p class="author-role">{t(p.role,lang)}</p>
    <p class="publication-result">{t(p.result,lang)}</p>
    <div class="publication-actions">
    <div class="resource-links">
      {paperHref && <a href={paperHref} target="_blank" rel="noopener noreferrer">Paper<Icon name="external" size={14} /></a>}
      {p.links.code && <a href={p.links.code} target="_blank" rel="noopener noreferrer">Code<Icon name="external" size={14} /></a>}
      {p.project && <a href={workPath(p.project,lang)}>{words(lang,'Project','Dự án')}<Icon name="arrow" size={14} /></a>}
    </div>
    {p.abstractExcerpt && <details class="disclosure"><summary>Abstract <span class="disclosure-sign" aria-hidden="true">+</span></summary><div class="disclosure-content"><p class="caption">{words(lang,'Excerpt from the abstract','Trích đoạn abstract')}</p><blockquote lang="en">{p.abstractExcerpt}</blockquote><a href={p.source} target="_blank" rel="noopener noreferrer">{words(lang,'Read the full abstract at source','Đọc abstract đầy đủ tại nguồn')}<Icon name="external" size={14} /></a></div></details>}
    {p.bibtex && <details class="disclosure bibtex"><summary>BibTeX <span class="disclosure-sign" aria-hidden="true">+</span></summary><div class="disclosure-content"><div class="copy-bar"><button type="button" class="copy-button" data-copy data-success={words(lang,'Copied','Đã sao chép')} data-failure={words(lang,'Copy unavailable. Select the text below to copy manually.','Không thể sao chép tự động. Hãy chọn nội dung bên dưới để sao chép.')}><Icon name="copy" size={16} />{words(lang,'Copy citation','Sao chép trích dẫn')}</button><span class="copy-status" role="status" aria-live="polite"></span></div><pre tabindex="0" aria-label={words(lang,'BibTeX citation','Trích dẫn BibTeX')}><code>{p.bibtex}</code></pre></div></details>}
    </div>
  </div>
</article>
