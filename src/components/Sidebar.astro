---
import { existsSync } from 'node:fs';
import { profile } from '../data/profile';
import { type Lang, t, words, pathFor } from '../lib/site';
import Icon from './Icon.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { visibleGallery } from '../data/extras';
import { credentials } from '../data/credentials.mjs';
const { lang, hasNews = true, page = 'home' } = Astro.props as {lang: Lang; hasNews?: boolean; page?: string};
const sections = [['about',words(lang,'About','Giới thiệu')],...(hasNews ? [['news',words(lang,'News','Cập nhật')]] : []),['work',words(lang,'Selected work','Công việc tiêu biểu')],['research',words(lang,'Publications','Công bố')],['background',words(lang,'Background','Học vấn & nghiên cứu')]];
const cv = existsSync('public/cv.pdf');
sections.push(['awards', words(lang,'Awards & funding','Giải thưởng & tài trợ')]);
if (credentials.length) sections.push(['certificates', words(lang,'Certifications','Chứng chỉ')]);
sections.push(['open-source', words(lang,'Contributions','Đóng góp xây dựng')]);
if (visibleGallery.length) sections.push(['gallery', words(lang,'Gallery','Hình ảnh')]);
const photo = existsSync('public/khoa.jpg');
---
<aside class="sidebar">
  <div class:list={['identity', { 'has-portrait': photo }]}>
    <div class="identity-copy">
    {page === 'home' ? <h1>{profile.name}</h1> : <a class="identity-name" href={pathFor('/',lang)}>{profile.name}</a>}
    {photo && <img class="portrait" src="/khoa.jpg" alt={profile.fullName} width="152" height="152" />}
    <p class="identity-title">{t(profile.title,lang)}</p>
    <p class="tagline">{t(profile.tagline,lang)}</p>
    </div>
  </div>
  {cv && <a class="cv-button" href="/cv.pdf"><Icon name="paper" />{words(lang,'Download CV','Tải CV')}<Icon name="arrow" size={16} /></a>}
  <nav class="section-nav" aria-label={words(lang,'Portfolio sections','Các mục portfolio')}>
    {sections.map(([id,label]) => <a href={`${pathFor('/',lang)}#${id}`} data-section-link={page==='home' ? id : undefined} aria-current={page===id ? 'page' : undefined}>{label}</a>)}
  </nav>
  <div class="social-links">
    <a href={`mailto:${profile.email}`}><Icon name="mail" />Email</a>
    <a href={profile.links.github} target="_blank" rel="noopener noreferrer"><Icon name="github" />GitHub</a>
    <a href={profile.links.scholar} target="_blank" rel="noopener noreferrer"><Icon name="school" />Scholar</a>
    <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" />LinkedIn</a>
  </div>
  <LanguageSwitch lang={lang} />
</aside>
