---
import Base from '../layouts/Base.astro';
import Sidebar from './Sidebar.astro';
import ProjectRow from './ProjectRow.astro';
import PublicationRow from './PublicationRow.astro';
import Footer from './Footer.astro';
import { type Lang, registry, words } from '../lib/site';
const { lang, kind } = Astro.props as {lang: Lang; kind: 'work'|'research'};
const { projects, papers, news } = await registry();
const heading = kind==='work' ? words(lang,'Work','Công việc') : words(lang,'Publications','Công bố');
const description = kind==='work' ? words(lang,'Engineering projects and research contributions, from model experiments to usable systems.','Các dự án kỹ thuật và đóng góp nghiên cứu, từ thực nghiệm mô hình đến hệ thống có thể sử dụng.') : words(lang,'Research in handwritten mathematics, molecular generation, and cross-modal learning.','Nghiên cứu nhận dạng toán viết tay, sinh phân tử và học đa phương thức.');
---
<Base lang={lang} title={`${heading} — Khoa Nguyen`} description={description}><div class="site-shell"><Sidebar lang={lang} page={kind} hasNews={news.length>0} /><main id="main" class="main-column"><div class="index-heading"><h1>{heading}</h1><p class="intro">{description}</p></div>{kind==='work' ? <div class="project-list">{projects.map((p,i)=><ProjectRow project={p} lang={lang} eager={i===0} />)}</div> : <div class="publication-list">{papers.map(p=><PublicationRow paper={p} lang={lang} />)}</div>}<Footer lang={lang} /></main></div></Base>
