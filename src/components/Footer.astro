---
import { type Lang, words } from '../lib/site';
import { profile } from '../data/profile';
import Icon from './Icon.astro';
const { lang } = Astro.props as {lang: Lang};
---
<footer class="footer" id="contact"><h2>{words(lang,'Get in touch','Liên hệ')}</h2><a class="text-link" href={`mailto:${profile.email}`}><Icon name="mail" />Email</a></footer>
