---
import { type Lang, words } from '../lib/site';
import ImagePreview from './ImagePreview.astro';
import Icon from './Icon.astro';
import { credentials } from '../data/credentials.mjs';
const { c, lang } = Astro.props as { c: (typeof credentials)[number]; lang: Lang };
const kind = c.kind === 'Course' ? words(lang, 'Course', 'Khóa học') : c.kind === 'Specialization' ? words(lang, 'Specialization', 'Chuyên môn hóa') : words(lang, 'Professional Certificate', 'Chứng chỉ chuyên môn');
---
<li data-credential={c.id}><Icon name="school" size={22} /><div>
  <h3><a href={c.url} target="_blank" rel="noopener noreferrer">{c.title}<Icon name="external" size={14} /></a></h3>
  <p>{c.issuer} · {c.year} · Coursera</p>
  <div class="credential-actions"><span>{kind}</span><ImagePreview id={c.id} src={c.image} caption={`${c.title} · ${c.issuer} · ${c.date}`} lang={lang} /></div>
</div></li>
